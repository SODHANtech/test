[
  {
    "startSec": 0.1,
    "endSec": 3.821,
    "startFrame": 3,
    "endFrame": 115,
    "text": "India announced 5.9 million tonnes of lithium in Jammu."
  },
  {
    "startSec": 3.771,
    "endSec": 5.51,
    "startFrame": 113,
    "endFrame": 165,
    "text": "But there was a catch."
  },
  {
    "startSec": 5.51,
    "endSec": 8.543,
    "startFrame": 165,
    "endFrame": 256,
    "text": "It wasn't 5.9 million tonnes of lithium."
  },
  {
    "startSec": 8.543,
    "endSec": 13.336,
    "startFrame": 256,
    "endFrame": 400,
    "text": "It was early-stage ore, with an average grade of just 583 parts per million."
  },
  {
    "startSec": 13.336,
    "endSec": 16.0,
    "startFrame": 400,
    "endFrame": 480,
    "text": "That is zero point zero five percent."
  },
  {
    "startSec": 16.0,
    "endSec": 18.38,
    "startFrame": 480,
    "endFrame": 551,
    "text": "And finding ore is only step one."
  },
  {
    "startSec": 18.38,
    "endSec": 20.847,
    "startFrame": 551,
    "endFrame": 625,
    "text": "Raw rock cannot enter a battery."
  },
  {
    "startSec": 20.847,
    "endSec": 28.173,
    "startFrame": 625,
    "endFrame": 845,
    "text": "To turn that ore into battery chemicals, it must be crushed, concentrated, roasted at a thousand degrees, chemically leached, and purified."
  },
  {
    "startSec": 28.173,
    "endSec": 31.097,
    "startFrame": 845,
    "endFrame": 933,
    "text": "Only then do you get battery-grade materials."
  },
  {
    "startSec": 31.097,
    "endSec": 32.836,
    "startFrame": 933,
    "endFrame": 985,
    "text": "Here is the twist:"
  },
  {
    "startSec": 32.836,
    "endSec": 36.119,
    "startFrame": 985,
    "endFrame": 1084,
    "text": "China refines 65% of the world's lithium."
  },
  {
    "startSec": 36.119,
    "endSec": 39.195,
    "startFrame": 1084,
    "endFrame": 1176,
    "text": "Indonesia refines 40% of its nickel."
  },
  {
    "startSec": 39.195,
    "endSec": 42.141,
    "startFrame": 1176,
    "endFrame": 1264,
    "text": "The real monopoly isn't the rocks in the ground."
  },
  {
    "startSec": 42.141,
    "endSec": 44.021,
    "startFrame": 1264,
    "endFrame": 1321,
    "text": "It is the refineries."
  },
  {
    "startSec": 44.021,
    "endSec": 51.521,
    "startFrame": 1321,
    "endFrame": 1546,
    "text": "That is why India approved a 2,814 crore rupee scheme for four future processing plants, with a 30 percent capital subsidy."
  },
  {
    "startSec": 51.521,
    "endSec": 54.532,
    "startFrame": 1546,
    "endFrame": 1636,
    "text": "Because discovering a mineral gives you potential."
  },
  {
    "startSec": 54.532,
    "endSec": 56.804,
    "startFrame": 1636,
    "endFrame": 1704,
    "text": "Processing it gives you power."
  }
]